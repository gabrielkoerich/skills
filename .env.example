# Skills environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# Or use the interactive setup script:
#   ./setup.sh

# ── elevenlabs-voices ────────────────────────────────────────────
# Get your API key at https://elevenlabs.io
# export ELEVEN_API_KEY=""

# ── github-secrets ───────────────────────────────────────────────
# GitHub Personal Access Token (scopes: repo, admin:org)
# export GITHUB_TOKEN=""

# ── intelbras ────────────────────────────────────────────────────
# Alarm panel
# export INTELBRAS_ALARM_HOST="192.168.1.100"
# export INTELBRAS_ALARM_PORT="80"
# export INTELBRAS_ALARM_USERNAME="admin"
# export INTELBRAS_ALARM_PASSWORD=""
# export INTELBRAS_ALARM_ENABLED="true"

# DVR / cameras
# export INTELBRAS_DVR_HOST="192.168.1.200"
# export INTELBRAS_DVR_PORT="80"
# export INTELBRAS_DVR_RTSP_PORT="554"
# export INTELBRAS_DVR_USERNAME="admin"
# export INTELBRAS_DVR_PASSWORD=""
